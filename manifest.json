{
  "manifest_version": 3,
  "name": "Einführungskurs für SolidCraft – 3D-Konstruieren auf Deutsch",
  "version": "0.2.0",
  "description": "Geführter 3D-Konstruktionskurs für Kinder direkt im SolidCraft-Editor: Namensschild, Schlüsselanhänger, Würfel und mehr. Für Schule, AG und Zuhause.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Einführungskurs für SolidCraft",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "contextMenus",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://app.solidcraft.io/*"
  ]
}
